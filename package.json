{
  "name": "react-native---next.js-learning-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "pnpm prettier . --write",
    "format:check": "pnpm prettier . --check",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:restart": "docker compose restart"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "turbo": "^2.11.7"
  },
  "engines": {
    "pnpm": "12.10.0",
    "node": ">=24.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.12.0",
      "onFail": "download"
    }
  }
}
