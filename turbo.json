{
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".dist/**"]
        },
        "lint": {
            "dependsOn": ["^lint"],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        }
    }
}